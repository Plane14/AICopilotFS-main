  "vfsProjectionRoot": null,
  
  // Explicit UserCfg.opt path
  "userCfgPath": null,
  
  // Explicit flight plan path (CUSTOMFLIGHT.PLN)
  "flightPlanPath": null,
  
  // MSFS 2024 executable path (for panel building)
