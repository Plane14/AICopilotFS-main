<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Location of the MSFS 2024 SDK. Override with:
        dotnet build -p:MsfsSdkDir="C:\MSFS SDK"
      Search order:
        1. -p:MsfsSdkDir=... passed to the build
        2. The "SimConnect SDK" folder inside this repo
        3. The SDK installed with MSFS 2024 (Microsoft Store install)
    -->
    <MsfsSdkDir Condition=" '$(MsfsSdkDir)' == '' ">$(MSBuildThisFileDirectory)..\SimConnect SDK</MsfsSdkDir>
  </PropertyGroup>

  <PropertyGroup>
    <SimConnectDll>$(MsfsSdkDir)/lib/SimConnect.dll</SimConnectDll>
    <!-- Fallback to the SimConnect.dll that ships with an installed MSFS 2024 -->
    <SimConnectDll Condition=" !Exists('$(SimConnectDll)') and '$(LocalAppData)' != '' ">
      $(LocalAppData)\Packages\Microsoft.Limitless_8wekyb3d8bbwe\LocalCache\SimConnect SDK\lib\SimConnect.dll
    </SimConnectDll>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MSFS2024AIPilot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(SimConnectDll)" Condition=" Exists('$(SimConnectDll)') ">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>SimConnect.dll</Link>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>