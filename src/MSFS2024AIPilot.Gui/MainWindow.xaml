<Window x:Class="MSFS2024AIPilot.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Copilot — MSFS 2024" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✈ AI Copilot" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtConnection" Text="  ● disconnected" Margin="18,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource BadBrush}" FontSize="13"/>
                </StackPanel>
                <TextBlock x:Name="TxtAircraft" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource DimBrush}" FontSize="13"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Controls -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="CONTROL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DimBrush}" Margin="0,0,0,8"/>

                    <Button x:Name="BtnConnect" Content="Connect to Simulator" Padding="10,8" Margin="0,0,0,8" Click="BtnConnect_Click"
                            Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                    <TextBlock Text="Mode" Margin="0,6,0,4" Foreground="{StaticResource DimBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="RbOff" Content="Off" GroupName="mode" IsChecked="True" Margin="0,0,14,0" Foreground="{StaticResource TextBrush}"/>
                        <RadioButton x:Name="RbSingle" Content="Single flight" GroupName="mode" Margin="0,0,14,0" Foreground="{StaticResource TextBrush}"/>
                        <RadioButton x:Name="RbContinuous" Content="Continuous" GroupName="mode" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>

                    <TextBlock Text="Service time between legs" Margin="0,4,0,4" Foreground="{StaticResource DimBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="SldService" Minimum="0" Maximum="120" Value="20" Width="170" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtService" Text="20 min" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="BtnEngage" Content="Engage AI Pilot" Padding="10,9" Margin="0,14,0,6" Click="BtnEngage_Click"
                            Background="{StaticResource GoodBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                    <Button x:Name="BtnPause" Content="Pause" Padding="10,7" Margin="0,4" Click="BtnPause_Click" Background="{StaticResource PanelBrush}"
                            Foreground="{StaticResource TextBrush}" BorderBrush="#FF3A4250" BorderThickness="1" Cursor="Hand"/>
                    <Button x:Name="BtnDisengage" Content="Disengage" Padding="10,7" Margin="0,4" Click="BtnDisengage_Click" Background="{StaticResource PanelBrush}"
                            Foreground="{StaticResource BadBrush}" BorderBrush="#FF5A3030" BorderThickness="1" Cursor="Hand"/>
                    <Button x:Name="BtnNextLeg" Content="Fly next leg now" Padding="10,7" Margin="0,10,0,0" Click="BtnNextLeg_Click"
                            Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
                            BorderBrush="#FF3A4250" BorderThickness="1" Cursor="Hand"/>
                    <Button x:Name="BtnLoadPln" Content="Load flight plan (.pln)…" Padding="10,7" Margin="0,6,0,0" Click="BtnLoadPln_Click"
                            Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
                            BorderBrush="#FF3A4250" BorderThickness="1" Cursor="Hand"/>

                    <Separator Margin="0,16" Background="#FF3A4250"/>
                    <TextBlock Text="CHECKLIST" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DimBrush}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtChecklistPhase" Text="—" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtChecklistItem" Text="" Foreground="{StaticResource DimBrush}" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="BarChecklist" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="1"
                                 Background="#FF2A303A" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Mission status -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="#FF2A303A" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="PHASE" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                                <TextBlock x:Name="TxtPhase" Text="—" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FF2A303A" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="STATUS" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                                <TextBlock x:Name="TxtStatus" Text="—" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Width="220"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FF2A303A" CornerRadius="6" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="DISTANCE TO GO" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                                <TextBlock x:Name="TxtDistance" Text="—" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#FF191D23" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,30,0">
                                <TextBlock Text="DEPARTURE" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                                <TextBlock x:Name="TxtDep" Text="—" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,30,0">
                                <TextBlock Text="DESTINATION" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                                <TextBlock x:Name="TxtDest" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GoodBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="ETA" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                                <TextBlock x:Name="TxtEta" Text="—" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="#FF191D23" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="TELEMETRY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource DimBrush}" Margin="0,0,0,6"/>
                            <UniformGrid Columns="6">
                                <StackPanel><TextBlock Text="IAS" FontSize="10" Foreground="{StaticResource DimBrush}"/><TextBlock x:Name="TelIas" Text="—" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel><TextBlock Text="ALT" FontSize="10" Foreground="{StaticResource DimBrush}"/><TextBlock x:Name="TelAlt" Text="—" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel><TextBlock Text="HDG" FontSize="10" Foreground="{StaticResource DimBrush}"/><TextBlock x:Name="TelHdg" Text="—" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel><TextBlock Text="VS" FontSize="10" Foreground="{StaticResource DimBrush}"/><TextBlock x:Name="TelVs" Text="—" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel><TextBlock Text="GS" FontSize="10" Foreground="{StaticResource DimBrush}"/><TextBlock x:Name="TelGs" Text="—" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel><TextBlock Text="FUEL" FontSize="10" Foreground="{StaticResource DimBrush}"/><TextBlock x:Name="TelFuel" Text="—" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="6" Margin="0,10,0,0">
                                <StackPanel><TextBlock Text="WIND" FontSize="10" Foreground="{StaticResource DimBrush}"/><TextBlock x:Name="TelWind" Text="—" FontSize="13"/></StackPanel>
                                <StackPanel><TextBlock Text="OAT" FontSize="10" Foreground="{StaticResource DimBrush}"/><TextBlock x:Name="TelOat" Text="—" FontSize="13"/></StackPanel>
                                <StackPanel><TextBlock Text="GEAR" FontSize="10" Foreground="{StaticResource DimBrush}"/><TextBlock x:Name="TelGear" Text="—" FontSize="13"/></StackPanel>
                                <StackPanel><TextBlock Text="FLAPS" FontSize="10" Foreground="{StaticResource DimBrush}"/><TextBlock x:Name="TelFlaps" Text="—" FontSize="13"/></StackPanel>
                                <StackPanel><TextBlock Text="AP" FontSize="10" Foreground="{StaticResource DimBrush}"/><TextBlock x:Name="TelAp" Text="—" FontSize="13"/></StackPanel>
                                <StackPanel><TextBlock Text="ICE" FontSize="10" Foreground="{StaticResource DimBrush}"/><TextBlock x:Name="TelIce" Text="—" FontSize="13"/></StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="6" Margin="0,10,0,0">
                                <StackPanel Grid.ColumnSpan="6">
                                    <TextBlock Text="TRAFFIC" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                                    <TextBlock x:Name="TelTraffic" Text="—" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Log -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14">
                <DockPanel>
                    <TextBlock Text="LOG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DimBrush}" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                    <ListBox x:Name="LstLog" Background="Transparent" Foreground="{StaticResource DimBrush}" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer status strip -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock x:Name="TxtError" DockPanel.Dock="Right" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Out-of-process AI pilot · native SimConnect · MSFS 2024" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
